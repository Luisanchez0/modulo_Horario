# Frontend (Vite) environment variables
# Copy this file to .env.local for local development.

VITE_USUARIOS_API_URL=http://localhost:8001
VITE_MATERIAS_API_URL=http://localhost:8002
VITE_AULAS_API_URL=http://localhost:8003
VITE_HORARIO_API_URL=http://localhost:8004

# HTTP client defaults
VITE_API_TIMEOUT_MS=10000

# Frontend auth storage key
VITE_JWT_STORAGE_KEY=auth_token
